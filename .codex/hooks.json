{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet --manifest-path \"$(git rev-parse --show-toplevel)\"/Cargo.toml -- codex-hook --allow-status"
          }
        ]
      }
    ]
  }
}
